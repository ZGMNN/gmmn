# GMMN environment variables — copy to .env.local for dev, set as repo secrets for prod.
# Values prefixed with VITE_ are exposed to the browser bundle (Vite convention).

# Firebase (web app config — these are public-by-design, real security lives in Firebase Rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Observability (set when Phase 0 wires them up)
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Build metadata (auto-injected by CI in deploy.yml — leave blank for local dev)
VITE_BUILD_COMMIT=
VITE_BUILD_DATE=
